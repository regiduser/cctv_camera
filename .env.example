# Shared stream authentication token: set the SAME strong random value on both devices.
CCTV_STREAM_TOKEN=replace-with-a-long-random-token

# Receiver machine address and port (sender connects to this host)
RECEIVER_HOST=127.0.0.1
RECEIVER_PORT=9999
SOCKET_TIMEOUT=10

# Sender camera settings
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
CAMERA_FPS=20
JPEG_QUALITY=65
RECONNECT_DELAY=2

# Receiver recording settings
RECORD_FPS=20
RECORD_DIR=recordings

# Optional Telegram upload (receiver only)
TELEGRAM_UPLOAD=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO
